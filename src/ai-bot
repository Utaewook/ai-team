def ensure_user(bot):
    pw = bot.pw()
    if pw is None:
        run(["useradd", "--create-home", "--home-dir", bot.home, "--shell", "/bin/bash",
             "--user-group", "--comment", f"AI bot {bot.name}", bot.user], quiet=True)
        say(f"  👤 사용자 {bot.user} 생성")
        pw = bot.pw()
    if pw.pw_dir != bot.home:
        raise BotError(f"{bot.user} 의 홈이 {pw.pw_dir} 입니다 (기대값 {bot.home})")
    # 비밀번호 로그인 불가 상태 유지 (useradd 기본값이 잠금이지만 확인)
    groups = out(["id", "-nG", bot.user]).split()
    for g in groups:
        if g in FORBIDDEN_GROUPS:
            run(["gpasswd", "-d", bot.user, g], quiet=True)
            say(f"  🔒 {bot.user} 를 {g} 그룹에서 제외")
    ensure_dir(bot.home, 0o700, pw.pw_uid, pw.pw_gid)
    return pw


def ensure_subids(bot):
    """rootless Docker 에 필요한 subuid/subgid 범위."""
    for f, flag in (("/etc/subuid", "--add-subuids"), ("/etc/subgid", "--add-subgids")):
        lines = open(f).read().splitlines() if os.path.exists(f) else []
        if any(line.split(":")[0] == bot.user for line in lines):
            continue
        top = 100000
        for line in lines:
            parts = line.split(":")
            if len(parts) == 3 and parts[1].isdigit() and parts[2].isdigit():
                top = max(top, int(parts[1]) + int(parts[2]))
        run(["usermod", flag, f"{top}-{top + 65535}", bot.user], quiet=True)


def as_user(bot, cmd, env_extra=None, check=True, capture=True, input_text=None, cwd=None):
    pw = bot.pw()
    env = {"HOME": bot.home, "USER": bot.user, "LOGNAME": bot.user, "LANG": "C.UTF-8",
           "PATH": "/usr/local/bin:/usr/bin:/bin", "XDG_RUNTIME_DIR": f"/run/user/{pw.pw_uid}",
           "DBUS_SESSION_BUS_ADDRESS": f"unix:path=/run/user/{pw.pw_uid}/bus",
           "DISABLE_AUTOUPDATER": "1"}
    env.update(env_extra or {})
    full = ["runuser", "-u", bot.user, "--", "env", "-i"] + [f"{k}={v}" for k, v in env.items()]
    # sudo 를 실행한 폴더(예: 750 인 /home/ubuntu)를 봇이 못 읽을 수 있으니 항상 봇 홈에서 실행
    return run(full + list(cmd), check=check, capture=capture, input_text=input_text, cwd=cwd or bot.home)


def install_role_files(bot, pw):
    """역할 지침과 권한 규칙을 root 소유·봇 읽기 전용으로 설치."""
    ensure_dir(os.path.join(bot.home, "bots"), 0o750, 0, pw.pw_gid)
    ensure_dir(bot.cwd, 0o750, 0, pw.pw_gid)
    ensure_dir(os.path.join(bot.cwd, ".claude"), 0o750, 0, pw.pw_gid)
    src_md = os.path.join(bot.defdir, "CLAUDE.md")
    if os.path.isfile(src_md):
        with open(src_md, encoding="utf-8") as fh:
            write_file(os.path.join(bot.cwd, "CLAUDE.md"), fh.read(), 0o640, 0, pw.pw_gid)
    settings = load_json(os.path.join(bot.defdir, "settings.json"), {})
    dirs = list(settings.get("permissions", {}).get("additionalDirectories", []))
    extra = [bot.vault["dir"]] if bot.vault else []
    extra += list(bot.repos.values()) if bot.cfg.get("repos_in_settings", True) else []
    for d in extra:
        if d not in dirs:
            dirs.append(d)
    if dirs:
        settings.setdefault("permissions", {})["additionalDirectories"] = dirs
    if bot.cfg.get("browser"):
        perm = settings.setdefault("permissions", {})
        allow = perm.setdefault("allow", [])
        if "mcp__playwright" not in allow:
            allow.append("mcp__playwright")
        deny = perm.setdefault("deny", [])
        for t in ("browser_evaluate", "browser_run_code_unsafe", "browser_drop"):
            if f"mcp__playwright__{t}" not in deny:
                deny.append(f"mcp__playwright__{t}")
        allow_arg = ",".join(bot.cfg["browser"]["allow"])
        hook = {"type": "command", "command": GUARD + (f" --allow {allow_arg}" if allow_arg else "")}
        pre = settings.setdefault("hooks", {}).setdefault("PreToolUse", [])
        if not any(h.get("matcher") == "mcp__playwright__.*" for h in pre):
            pre.append({"matcher": "mcp__playwright__.*", "hooks": [hook]})
    rules = (("jira", "Bash(ai-jira *)"), ("google", "Bash(ai-google *)"), ("project", "Bash(ai-project *)"),
             ("browser", "Bash(ai-browser-relogin *)"))
    for flag, rule in rules:
        if (("project.add" in bot.cfg["approve"]) if flag == "project" else bot.cfg.get(flag)):
            allow = settings.setdefault("permissions", {}).setdefault("allow", [])
            if rule not in allow:
                allow.append(rule)
    write_file(os.path.join(bot.cwd, ".claude", "settings.json"),
               json.dumps(settings, ensure_ascii=False, indent=2) + "\n", 0o640, 0, pw.pw_gid)
    for w in bot.cfg["writable"]:
        ensure_dir(os.path.join(bot.cwd, w), 0o700, pw.pw_uid, pw.pw_gid)


def seed_claude_state(bot, pw):
    """첫 실행 화면(로그인·테마·폴더 신뢰 확인)이 tmux 안에서 봇을 멈추지 않도록 상태를 미리 기록.
    (CLAUDE_CODE_OAUTH_TOKEN 을 써도 온보딩 화면이 뜨는 알려진 동작에 대한 우회)"""
    ensure_dir(os.path.join(bot.home, ".claude"), 0o700, pw.pw_uid, pw.pw_gid)
    path = os.path.join(bot.home, ".claude.json")
    state = load_json(path, {})
    changed = False
    if not state.get("hasCompletedOnboarding"):
        state["hasCompletedOnboarding"] = True
        changed = True
    projects = state.setdefault("projects", {})
    for d in [bot.cwd, *bot.repos.values()] + ([bot.vault["dir"]] if bot.vault else []):
        p = projects.setdefault(d, {})
        if not p.get("hasTrustDialogAccepted"):
            p["hasTrustDialogAccepted"] = True
            changed = True
    if bot.cfg.get("browser"):
        server = {"type": "stdio", "command": NODE, "args": [PW_MCP, "--config", bot.pw_config], "env": {}}
        if state.get("mcpServers", {}).get("playwright") != server:
            state.setdefault("mcpServers", {})["playwright"] = server
            changed = True
    elif "playwright" in state.get("mcpServers", {}):
        state["mcpServers"].pop("playwright")
        changed = True
    if changed or not os.path.exists(path):
        write_file(path, json.dumps(state, ensure_ascii=False, indent=2) + "\n", 0o600, pw.pw_uid, pw.pw_gid)


