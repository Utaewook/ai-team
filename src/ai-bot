    if out(["systemctl", "is-active", bot.unit]) != "active":
        return None
    started = out(["systemctl", "show", bot.unit, "-p", "ActiveEnterTimestampMonotonic", "--value"])
    try:
        return time.clock_gettime(time.CLOCK_MONOTONIC) - int(started) / 1e6
    except ValueError:
        return None


def check_bot(bot, table):
    up = uptime_seconds(bot)
    if up is None:
        return "inactive", "서비스가 active 가 아님 (systemd 가 재시작 담당)"
    if up < GRACE_SECONDS:
        return "starting", f"시작 {int(up)}초째"
    pid = claude_pid(bot)
    if not pid or pid not in table:
        return "no-plugin", "tmux 안에 Claude 프로세스가 없음"
    if plugin_attached(table, pid):
        return "ok", f"Claude {pid} 에 플러그인 연결됨"
    return "no-plugin", f"Claude {pid} 에 Telegram 플러그인이 없음"


def decide(state, status, now):
    state = dict(state)
    state["restarts"] = [t for t in state.get("restarts", []) if now - t < 3600]
    if status in ("ok", "starting", "inactive"):
        if status == "ok":
            state["fails"] = 0
            state["gave_up"] = False
        return "none", state
    state["fails"] = state.get("fails", 0) + 1
    if state["fails"] < FAILS_BEFORE_RESTART:
        return "none", state
    if len(state["restarts"]) >= MAX_RESTARTS_PER_HOUR:
        if state.get("gave_up"):
            return "none", state
        state["gave_up"] = True
        return "give-up", state
    state["fails"] = 0
    state["restarts"].append(now)
    return "restart", state


def notify(bot, text):
    """봇 자신의 토큰으로 사용자에게 알림 (실패해도 감시는 계속)."""
    try:
        token = read_env_file(bot.tg_env)["TELEGRAM_BOT_TOKEN"]
        chat_id = load_json(bot.access, {}).get("allowFrom", [None])[0] \
            or str((team_config().get("telegram") or {}).get("chat_id"))
        data = json.dumps({"chat_id": chat_id, "text": text}).encode()
        req = urllib.request.Request(f"https://api.telegram.org/bot{token}/sendMessage", data=data,
                                     headers={"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=15).read()
    except Exception as err:  # noqa: BLE001
        print(f"알림 실패({bot.name}): {type(err).__name__}", file=sys.stderr)


def cmd_watchdog(args):
    state_dir = os.path.join(STATE, "watchdog")
    os.makedirs(state_dir, exist_ok=True)
    table = process_table()
    now = time.time()
    for bot in all_bots(include_disabled=False):
        if not bot.cfg["telegram"]:
            continue
        status, detail = check_bot(bot, table)
        if args.status:
            say(f"{bot.name:12} {status:10} {detail}")
            continue
        path = os.path.join(state_dir, f"{bot.name}.json")
        action, state = decide(load_json(path, {"fails": 0, "restarts": [], "gave_up": False}), status, now)
        write_file(path, json.dumps(state), 0o600)
        if action == "restart":
            say(f"{bot.name}: {detail} → 재시작")
            systemctl("restart", bot.unit, check=False)
            notify(bot, f"🔄 {bot.name} 봇의 Telegram 연결이 끊겨 자동으로 재시작했어요.\n({detail})\n1~2분 뒤부터 메시지를 받을 수 있어요.")
        elif action == "give-up":
            say(f"{bot.name}: {detail} → 1시간 재시작 한도 초과, 중단")
            notify(bot, f"⚠️ {bot.name} 봇이 1시간에 {MAX_RESTARTS_PER_HOUR}번 재시작했는데도 Telegram 연결이 안 돼요. "
                        f"자동 재시작을 멈췄으니 확인이 필요해요.\n({detail})\n확인: sudo ai-bot logs {bot.name}")
        elif status != "ok":
            say(f"{bot.name}: {status} ({detail}), 연속 {state['fails']}회")
    return 0


