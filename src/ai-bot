def install_claude():
    """공식 설치 스크립트를 임시 HOME 에서 실행하고 실행 파일만 root 소유 공용 위치로 옮긴다.
    봇은 자기 claude 를 바꿀 수 없고(자동 업데이트도 끔), 업데이트는 sudo ai-bot update 로 한 곳에서."""
    tmp = tempfile.mkdtemp(prefix="ai-bot-claude-")
    try:
        env = {"HOME": tmp, "PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8"}
        run(["bash", "-c", "curl -fsSL https://claude.ai/install.sh | bash"], env=env, quiet=True)
        real = os.path.realpath(os.path.join(tmp, ".local", "bin", "claude"))
        if not os.path.isfile(real):
            raise BotError("claude 설치 결과를 찾지 못했습니다")
        version = os.path.basename(real)
        dest_dir = os.path.join(LIB, "claude")
        os.makedirs(dest_dir, exist_ok=True)
        dest = os.path.join(dest_dir, version)
        shutil.copy2(real, dest + ".tmp")
        os.chmod(dest + ".tmp", 0o755)
        os.replace(dest + ".tmp", dest)
        link_atomic(dest, CLAUDE)
        return version
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def install_bun():
    target = os.path.join(LIB, "bun")
    env = {"HOME": tempfile.mkdtemp(prefix="ai-bot-bun-"), "BUN_INSTALL": target, "SHELL": "/bin/sh",
           "PATH": "/usr/local/bin:/usr/bin:/bin"}
    try:
        run(["bash", "-c", "curl -fsSL https://bun.sh/install | bash"], env=env, quiet=True)
    finally:
        shutil.rmtree(env["HOME"], ignore_errors=True)
    link_atomic(os.path.join(target, "bin", "bun"), os.path.join(BIN, "bun"))
    return out([os.path.join(BIN, "bun"), "--version"])


def link_atomic(src, link):
    tmp = link + ".ai-bot-tmp"
    if os.path.lexists(tmp):
        os.unlink(tmp)
    os.symlink(src, tmp)
    os.replace(tmp, link)


