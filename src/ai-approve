        return yaml.safe_load(fh) or {}


class JiraAdmin:
    """root 전용 토큰(jira-admin.env)으로 사용자 지정 필드의 드롭다운 옵션만 다룬다."""

    def __init__(self, env=None):
        env = env or read_env(JIRA_ADMIN)
        if not env.get("JIRA_TOKEN"):
            raise Refuse("Jira 설정 변경용 토큰이 없습니다. 관리자가 sudo ai-approve setup-jira-admin 으로 등록해야 합니다.")
        scoped = env.get("JIRA_TOKEN_SCOPED", "true").lower() in ("1", "true", "yes")
        self.base = f"https://api.atlassian.com/ex/jira/{env['JIRA_CLOUD_ID']}" if scoped else env["JIRA_URL"].rstrip("/")
        self.auth = "Basic " + base64.b64encode(f"{env['JIRA_EMAIL']}:{env['JIRA_TOKEN']}".encode()).decode()
        self.fields = (team_config().get("jira") or {}).get("fields") or {}

    def req(self, method, path, body=None):
        return http(method, self.base + path, body, {"Authorization": self.auth, "Accept": "application/json"})

    def field_id(self, alias):
        fid = self.fields.get(alias)
        if not fid:
            raise Refuse(f"team-config.yaml 의 jira.fields 에 {alias} 가 없습니다")
        return fid

    def context_id(self, fid):
        ctx = self.req("GET", f"/rest/api/3/field/{fid}/context?maxResults=50").get("values") or []
        if not ctx:
            raise Refuse(f"{fid} 필드에 컨텍스트가 없습니다")
        glob = [c for c in ctx if c.get("isGlobalContext")]
        return (glob or ctx)[0]["id"]

    def options(self, alias):
        fid = self.field_id(alias)
        cid = self.context_id(fid)
        out, start = [], 0
        while True:
            page = self.req("GET", f"/rest/api/3/field/{fid}/context/{cid}/option?startAt={start}&maxResults=100")
            vals = page.get("values") or []
            out += vals
            if page.get("isLast", True) or not vals:
                break
            start += len(vals)
        return fid, cid, out

    def add_option(self, alias, value):
        """옵션을 추가. 이미 있으면(비활성이면 다시 켬) False."""
        fid, cid, opts = self.options(alias)
        for o in opts:
            if o.get("value") == value:
                if o.get("disabled"):
                    self.req("PUT", f"/rest/api/3/field/{fid}/context/{cid}/option",
                             {"options": [{"id": o["id"], "value": value, "disabled": False}]})
                    return True
                return False
        self.req("POST", f"/rest/api/3/field/{fid}/context/{cid}/option", {"options": [{"value": value}]})
        return True


# ───────────────────────────── 프로젝트(Product) 추가·브리프 ─────────────────────────────

def one_line(value, field, limit):
    value = str(value or "").strip()
    if not value or len(value) > limit or "\n" in value or "\r" in value:
        raise Refuse(f"{field} 는 1~{limit}자 한 줄")
    return value


def clean_brief(text, key, name=None):
    text = str(text or "").replace("\r\n", "\n").strip()
    if not 20 <= len(text) <= MAX_BRIEF:
        raise Refuse(f"brief 는 20~{MAX_BRIEF}자")
    if not text.startswith("# "):
        text = f"# {key} — {name or key}\n\n{text}"
    return text + "\n"


def validate_project_add(p):
    key = str(p.get("key") or "").strip().upper()
    if not KEY_RE.match(key):
        raise Refuse("key 는 영문 대문자로 시작하는 2~10자 (영문 대문자·숫자)")
    if key in (team_config().get("products") or {}):
        raise Refuse(f"{key} 는 이미 있는 프로젝트입니다 (브리프 수정은 project.brief)")
    name = one_line(p.get("name"), "name", 60)
    try:
        share = round(float(p.get("share", 0.2)), 2)
    except (TypeError, ValueError):
        raise Refuse("share 는 숫자 (0.05~1)") from None
    if not 0.05 <= share <= 1:
        raise Refuse("share 는 0.05~1")
    return {"key": key, "name": name, "share": share, "brief": clean_brief(p.get("brief"), key, name)}


def validate_project_brief(p):
    key = str(p.get("key") or "").strip().upper()
    if key not in (team_config().get("products") or {}):
        raise Refuse(f"{key} 는 등록된 프로젝트가 아닙니다 (새 프로젝트는 project.add)")
    name = key
    try:
        with open(os.path.join(brief_dir(), f"{key}.md"), encoding="utf-8") as fh:
            m = re.search(r"^#\s+\S+\s+—\s+(.+)$", fh.read(), re.M)
            name = m.group(1).strip() if m else key
    except FileNotFoundError:
        pass
    return {"key": key, "brief": clean_brief(p.get("brief"), key, name)}


def describe_project(p):
    head = f"프로젝트 {p['key']}" + (f" — {p['name']} (사용량 비율 {p['share']})" if "name" in p else " 브리프 교체")
    brief = p["brief"] if len(p["brief"]) <= 1500 else p["brief"][:1500] + "\n…(생략)"
    return f"{head}\n\n{brief}"


def brief_dir():
    return team_config().get("context_dir") or "/etc/ai-team-projects"


def write_text(path, text, mode=0o644):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def add_product_line(key, share, name):
    """team-config.yaml 의 products 블록 끝에 한 줄 추가 (주석·순서 유지). 결과를 YAML 로 다시 읽어 확인."""
    with open(TEAM_CONFIG, encoding="utf-8") as fh:
        lines = fh.read().split("\n")
    start = next((i for i, l in enumerate(lines) if re.match(r"^products:\s*(#.*)?$", l)), None)
    if start is None:
        raise Refuse("team-config.yaml 에 products: 블록이 없습니다")
    last = start
    for i in range(start + 1, len(lines)):
        if re.match(r"^\s+[A-Za-z0-9_]+\s*:", lines[i]):
            last = i
        elif lines[i].strip() == "" or lines[i].lstrip().startswith("#") and lines[i].startswith(" "):
            continue
        else:
            break
    safe_name = re.sub(r"[#\n]", " ", name)
    lines.insert(last + 1, f"  {key}: {share}     # {safe_name}")
    text = "\n".join(lines)
    check = yaml.safe_load(text) or {}
    if (check.get("products") or {}).get(key) != share:
        raise Refuse("team-config.yaml 수정 결과를 확인하지 못했습니다 (변경하지 않음)")
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    with open(os.path.join(STATE, f"team-config.{now().strftime('%Y%m%d-%H%M%S')}.bak"), "w", encoding="utf-8") as fh:
        fh.write(open(TEAM_CONFIG, encoding="utf-8").read())
    write_text(TEAM_CONFIG, text, os.stat(TEAM_CONFIG).st_mode & 0o777)


def refresh_shared_products():
    """ai-jira 가 검사하는 /etc/ai-team-jira.yaml 의 products 목록 갱신."""
    try:
        with open(JIRA_SHARED, encoding="utf-8") as fh:
            text = fh.read()
    except FileNotFoundError:
        return
    head = "".join(l + "\n" for l in text.split("\n") if l.startswith("#"))
    shared = yaml.safe_load(text) or {}
    shared["products"] = list((team_config().get("products") or {}).keys())
    write_text(JIRA_SHARED, head + yaml.safe_dump(shared, allow_unicode=True, sort_keys=False))


def rebuild_index():
    res = subprocess.run([UPDATE_INSTRUCTIONS, "--index-only"], capture_output=True, text=True, timeout=120)
    if res.returncode != 0:
        raise Refuse(f"프로젝트 목록 갱신 실패: {(res.stderr or res.stdout)[-300:]}")


def execute_project_add(p):
