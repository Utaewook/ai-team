# ───────────────────────────── 요청 저장소 ─────────────────────────────

def allowed_actions(bot):
    try:
        with open(os.path.join(ETC, "bots.d", bot, "bot.yaml"), encoding="utf-8") as fh:
            cfg = yaml.safe_load(fh) or {}
    except FileNotFoundError:
        return []
    if cfg.get("enabled", True) is False:
        return []
    return [a for a in (cfg.get("approve") or []) if a in ACTIONS]


class Store:
    def __init__(self):
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        self.lock = open(os.path.join(STATE, ".lock"), "w")
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        self.path = os.path.join(STATE, "pending.json")
        try:
            with open(self.path, encoding="utf-8") as fh:
                self.items = json.load(fh)
        except (FileNotFoundError, json.JSONDecodeError):
            self.items = {}
        self.expired = []
        for rid, item in list(self.items.items()):
            if dt.datetime.fromisoformat(item["expires"]) < now():
                self.expired.append(self.items.pop(rid))

    def save(self):
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(self.items, fh, ensure_ascii=False)
        os.chmod(tmp, 0o600)
        os.replace(tmp, self.path)

    def close(self):
        fcntl.flock(self.lock, fcntl.LOCK_UN)
        self.lock.close()


def code_hash(rid, code):
    return hashlib.sha256(f"{rid}:{code}".encode()).hexdigest()


def audit(event, **fields):
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    with open(os.path.join(STATE, "log.jsonl"), "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"at": now().isoformat(timespec="seconds"), "event": event, **fields}, ensure_ascii=False) + "\n")


def notify(text):
    sys.path.insert(0, DISPATCHER_DIR)
    import dispatcher  # noqa: E402
    cfg = dispatcher.load_config()
    dispatcher.notify(cfg, text)


def handle(bot, req):
    op = req.get("op")
    store = Store()
    try:
        for item in store.expired:
            audit("expired", id=item["id"], bot=item["bot"], action=item["action"])
        if store.expired:
            store.save()
        if op == "request":
            action = req.get("action")
            if action not in allowed_actions(bot):
                raise Refuse(f"{bot} 봇은 '{action}' 을 요청할 수 없습니다 (bot.yaml 의 approve 목록)")
            payload = ACTIONS[action]["validate"](req.get("payload") or {})
            if ACTIONS[action].get("direct"):
                try:
                    result = ACTIONS[action]["execute"](payload)
                except Refuse as err:
                    audit("failed", bot=bot, action=action, error=str(err))
                    raise
                audit("executed", bot=bot, action=action, result=result)
                notify(f"{ACTIONS[action]['title']} [{bot}] ✅ {result}\n\n{ACTIONS[action]['describe'](payload)}")
                return {"ok": True, "message": result}
            mine = [i for i in store.items.values() if i["bot"] == bot]
            if len(mine) >= MAX_PENDING:
                raise Refuse(f"대기 중인 요청이 {MAX_PENDING}건이라 더 받을 수 없습니다 (확인·취소 후 다시)")
            rid = secrets.token_hex(3)
            code = f"{secrets.randbelow(10**6):06d}"
            expires = now() + dt.timedelta(minutes=TTL_MIN)
            store.items[rid] = {"id": rid, "bot": bot, "action": action, "payload": payload, "tries": 0,
                                "hash": code_hash(rid, code), "expires": expires.isoformat()}
            store.save()
            audit("requested", id=rid, bot=bot, action=action, summary=ACTIONS[action]["describe"](payload)[:300])
            notify(f"{ACTIONS[action]['title']} 승인 요청 [{bot}] #{rid}\n\n{ACTIONS[action]['describe'](payload)}\n\n"
                   f"🔑 승인 코드: {code}\n이 내용이 맞으면 코드를 {bot} 에게 답장으로 보내세요. "
                   f"이상하면 무시하세요 ({TTL_MIN}분 뒤 자동 취소).")
            return {"ok": True, "id": rid, "expires_in_min": TTL_MIN,
                    "message": "승인 요청을 사람에게 보냈습니다. 사람이 알려 주는 코드를 confirm 으로 넘기세요."}
        if op in ("confirm", "cancel"):
            rid = str(req.get("id") or "")
            item = store.items.get(rid)
            if not item or item["bot"] != bot:
                raise Refuse(f"요청 #{rid} 가 없습니다 (만료됐거나 다른 봇의 요청)")
            if op == "cancel":
                store.items.pop(rid)
                store.save()
                audit("cancelled", id=rid, bot=bot)
                return {"ok": True, "message": f"#{rid} 취소"}
            code = re.sub(r"\D", "", str(req.get("code") or ""))
            if not hmac.compare_digest(code_hash(rid, code), item["hash"]):
                item["tries"] += 1
                left = MAX_TRIES - item["tries"]
                audit("bad_code", id=rid, bot=bot, tries=item["tries"])
                if left <= 0:
                    store.items.pop(rid)
                    store.save()
                    notify(f"⚠️ 승인 요청 #{rid} 코드가 {MAX_TRIES}번 틀려 취소했습니다 [{bot}]")
                    raise Refuse("코드가 3번 틀려 요청을 취소했습니다")
                store.save()
                raise Refuse(f"코드가 맞지 않습니다 (남은 시도 {left}번)")
            store.items.pop(rid)
            store.save()
            try:
                result = ACTIONS[item["action"]]["execute"](item["payload"])
            except Refuse as err:
                audit("failed", id=rid, bot=bot, error=str(err))
                notify(f"❌ #{rid} 실행 실패: {err}")
                raise
            audit("executed", id=rid, bot=bot, action=item["action"], result=result)
            notify(f"✅ #{rid} {result}")
            return {"ok": True, "message": result}
        if op == "list":
            return {"ok": True, "pending": [{"id": i["id"], "action": i["action"], "expires": i["expires"],
                                             "summary": ACTIONS[i["action"]]["describe"](i["payload"])[:200]}
                                            for i in store.items.values() if i["bot"] == bot]}
        raise Refuse(f"알 수 없는 op: {op}")
    finally:
        store.close()


def peer_user(conn):
    creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    _pid, uid, _gid = struct.unpack("3i", creds)
    name = pwd.getpwuid(uid).pw_name
    if not name.startswith("bot-"):
        raise Refuse("봇 사용자만 요청할 수 있습니다")
    return name[4:]


def serve_conn(conn):
    try:
        bot = peer_user(conn)
        data = b""
        conn.settimeout(10)
        while not data.endswith(b"\n") and len(data) < 200_000:
            chunk = conn.recv(65536)
            if not chunk:
                break
            data += chunk
        resp = handle(bot, json.loads(data.decode("utf-8")))
    except Refuse as err:
        resp = {"ok": False, "error": str(err)}
    except (json.JSONDecodeError, UnicodeDecodeError):
        resp = {"ok": False, "error": "요청 형식 오류"}
    except Exception as err:  # noqa: BLE001
        resp = {"ok": False, "error": f"내부 오류: {type(err).__name__}"}
    conn.sendall((json.dumps(resp, ensure_ascii=False) + "\n").encode())


def cmd_serve(_a):
    conn = socket.socket(fileno=0)
    try:
        serve_conn(conn)
    finally:
        conn.close()
    return 0


