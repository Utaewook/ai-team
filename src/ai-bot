def github_get(token, path):
    req = urllib.request.Request(f"https://api.github.com{path}",
                                 headers={"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json",
                                          "User-Agent": "ai-bot"})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return resp.status, json.load(resp)
    except urllib.error.HTTPError as err:
        return err.code, {}


def check_github(bot, token):
    status, me = github_get(token, "/user")
    if status != 200:
        raise BotError(f"GitHub 토큰 확인 실패 (HTTP {status})")
    gh = bot.cfg.get("github") if isinstance(bot.cfg.get("github"), dict) else {}
    must_see = list(gh.get("must_see") or [])
    if bot.vault:
        m = re.search(r"github\.com[:/]([^/]+/[^/.]+)", bot.vault["repo"])
        if m:
            must_see.append(m.group(1))
    problems = []
    for repo in must_see:
        if github_get(token, f"/repos/{repo}")[0] != 200:
            problems.append(f"❌ {repo} 에 접근할 수 없음 (필요함)")
    for repo in gh.get("must_not_see") or []:
        if github_get(token, f"/repos/{repo}")[0] == 200:
            problems.append(f"🚨 {repo} 가 보임 — 이 봇에게 허용하면 안 되는 저장소입니다")
    return me.get("login", "?"), problems


def check_telegram(token):
    try:
        with urllib.request.urlopen(f"https://api.telegram.org/bot{token}/getMe", timeout=20) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as err:
        raise BotError(f"Telegram 토큰 확인 실패 (HTTP {err.code})") from None
    return data["result"]["username"]


def prompt_secret(label):
    if not sys.stdin.isatty():
        value = sys.stdin.readline().strip()
    else:
        value = getpass.getpass(f"{label} (입력 내용은 보이지 않습니다): ").strip()
    if not value:
        raise BotError("입력이 비어 있습니다")
    return value


def jira_myself(env):
    """토큰 확인. 일반 API 토큰은 사이트 주소(먼저 시도), 범위 지정 토큰은 api.atlassian.com 으로 확인하고
    맞는 방식을 env 의 JIRA_TOKEN_SCOPED 에 기록한다."""
    import base64
    auth = base64.b64encode(f"{env['JIRA_EMAIL']}:{env['JIRA_TOKEN']}".encode()).decode()
    last = None
    for scoped, base in (("false", env["JIRA_URL"].rstrip("/")),
                         ("true", f"https://api.atlassian.com/ex/jira/{env['JIRA_CLOUD_ID']}")):
        req = urllib.request.Request(base + "/rest/api/3/myself",
                                     headers={"Authorization": f"Basic {auth}", "Accept": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=20) as resp:
                env["JIRA_TOKEN_SCOPED"] = scoped
                return json.load(resp)
        except urllib.error.HTTPError as err:
            last = err.code
    raise BotError(f"Jira 토큰 확인 실패 (HTTP {last}) — 이메일과 토큰을 확인하세요")


def save_jira_secret(bot, pw):
    """봇 전용 Jira 계정의 범위 지정 토큰. 승인자(사람) 계정 토큰은 거부 — 봇이 관리 명령을 스스로 승인할 수 없게."""
    tc = team_config()
    site = ((tc.get("jira") or {}).get("site") or "").rstrip("/")
    dispatcher_env = read_env_file(((tc.get("jira") or {}).get("env_file")) or os.path.join(ETC, "jira.env"))
    cloud_id = dispatcher_env.get("JIRA_CLOUD_ID")
    if not (site and cloud_id):
        raise BotError("team-config.yaml 의 jira.site 또는 jira.env 의 JIRA_CLOUD_ID 가 없습니다")
    if sys.stdin.isatty():
        email = input(f"[{bot.name}] 이 봇의 Jira 계정 이메일: ").strip()
    else:
        email = sys.stdin.readline().strip()
    token = prompt_secret(f"[{bot.name}] 그 계정의 API 토큰 (범위 지정 또는 일반)")
    env = {"JIRA_URL": site, "JIRA_CLOUD_ID": cloud_id, "JIRA_EMAIL": email, "JIRA_TOKEN": token, "JIRA_TOKEN_SCOPED": "true"}
    me = jira_myself(env)
    approver = (tc.get("admin") or {}).get("approver_account_id")
    if approver and me.get("accountId") == approver:
        raise BotError("이 토큰은 관리 요청 승인자(사람) 계정입니다. 봇 전용 계정의 토큰을 넣어 주세요 (저장하지 않음).")
    if dispatcher_env.get("JIRA_EMAIL", "").lower() == email.lower():
        say("  ⚠️ 디스패처와 같은 Jira 계정입니다. 동작은 하지만 변경 기록에서 봇과 디스패처를 구분할 수 없습니다.")
    write_file(bot.jira_env, "".join(f"{k}={v}\n" for k, v in env.items()), 0o600, pw.pw_uid, pw.pw_gid)
    write_jira_shared()
    say(f"  🔑 Jira 토큰 저장 ({me.get('displayName', email)})")


def cmd_secret(args):
    bot = Bot(args.name)
    pw = bot.pw()
    if pw is None:
        raise BotError(f"{bot.user} 사용자가 아직 없습니다. 먼저 sudo ai-bot apply {bot.name}")
    ensure_user_dirs(bot, pw)
    kind = args.kind
    if kind == "claude":
        token = prompt_secret(f"[{bot.name}] claude setup-token 으로 만든 토큰")
        if not token.startswith("sk-ant-oat"):
            say("  ⚠️ setup-token 토큰은 보통 sk-ant-oat 로 시작합니다. 맞는지 확인해 주세요.")
        write_file(bot.claude_env, f"CLAUDE_CODE_OAUTH_TOKEN={token}\n", 0o600, pw.pw_uid, pw.pw_gid)
        say("  🔑 Claude 토큰 저장")
    elif kind == "telegram":
        if not bot.cfg["telegram"]:
            raise BotError(f"{bot.name} 는 telegram: false 입니다")
        token = prompt_secret(f"[{bot.name}] BotFather 가 준 봇 토큰")
        if not re.match(r"^\d+:[A-Za-z0-9_-]{30,}$", token):
            raise BotError("Telegram 봇 토큰 형식이 아닙니다 (숫자:영문)")
        for other in all_bots():
            if other.name != bot.name and read_env_file(other.tg_env).get("TELEGRAM_BOT_TOKEN") == token:
                raise BotError(f"이 토큰은 이미 {other.name} 가 쓰고 있습니다 (토큰 하나 = 봇 하나)")
        username = check_telegram(token)
        write_file(bot.tg_env, f"TELEGRAM_BOT_TOKEN={token}\n", 0o600, pw.pw_uid, pw.pw_gid)
        say(f"  🔑 Telegram 토큰 저장 (@{username})")
    elif kind == "jira":
        save_jira_secret(bot, pw)
    elif kind == "google":
        say("  Google 계정 연결: 메일 읽기 + 캘린더 일정 (발송 권한은 받지 않음 — 발송은 확인 서비스가 따로 가짐)")
        r = subprocess.run([APPROVE_BIN, "google-auth", "--scopes", " ".join(GOOGLE_SCOPES), "--out", bot.google_env,
                            "--owner", bot.user, "--forbid", " ".join(GOOGLE_FORBID)])
        if r.returncode != 0:
            raise BotError("Google 연결이 완료되지 않았습니다")
    elif kind == "github":
        token = prompt_secret(f"[{bot.name}] GitHub fine-grained 토큰")
        login, problems = check_github(bot, token)
        for p in problems:
            say(f"  {p}")
        if any(p.startswith("🚨") for p in problems):
            raise BotError("허용하면 안 되는 저장소가 보이는 토큰이라 저장하지 않았습니다. 저장소 범위를 좁혀 다시 발급해 주세요.")
        write_file(bot.git_cred, f"https://x-access-token:{token}@github.com\n", 0o600, pw.pw_uid, pw.pw_gid)
        ensure_dir(os.path.dirname(bot.gh_hosts), 0o700, pw.pw_uid, pw.pw_gid)
        write_file(bot.gh_hosts, f"github.com:\n    oauth_token: {token}\n    git_protocol: https\n    user: {login}\n",
                   0o600, pw.pw_uid, pw.pw_gid)
        say(f"  🔑 GitHub 토큰 저장 (계정 {login})")
    if not args.no_apply:
        # 이미 켜 둔 봇이면 새 토큰으로 재시작. 아직 켜지 않은 봇은 시작하지 않음
        # (이전·전환 중에 같은 Telegram 토큰을 두 프로그램이 받는 일을 막기 위해)
        enabled = out(["systemctl", "is-enabled", bot.unit]) == "enabled"
        apply_bot(bot, start=enabled)
        if enabled and bot.cfg["telegram"]:
            systemctl("restart", bot.unit, check=False)
            say(f"  🔄 {bot.unit} 재시작 (새 토큰 적용)")
        elif bot.cfg["telegram"]:
            say(f"  ▶ 시작하려면: sudo ai-bot apply {bot.name}")
    return 0


