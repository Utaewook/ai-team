def cmd_setup_jira_admin(a):
    tc = team_config()
    jenv = read_env(((tc.get("jira") or {}).get("env_file")) or os.path.join(ETC, "jira.env"))
    site = ((tc.get("jira") or {}).get("site") or "").rstrip("/")
    cloud = jenv.get("JIRA_CLOUD_ID")
    if not (cloud and site):
        raise Refuse("team-config.yaml 의 jira.site 또는 jira.env 의 JIRA_CLOUD_ID 가 없습니다")
    if a.from_bot:
        src = os.path.join(f"/home/bot-{a.from_bot}", ".config", "ai-bot", "jira.env")
        benv = read_env(src)
        if not benv.get("JIRA_TOKEN"):
            raise Refuse(f"{src} 에 토큰이 없습니다 (먼저 sudo ai-bot secret {a.from_bot} jira)")
        email, token = benv["JIRA_EMAIL"], benv["JIRA_TOKEN"]
        print(f"{a.from_bot} 봇의 Jira 토큰({email})을 드롭다운 옵션 추가에도 씁니다.")
    else:
        print("Jira 드롭다운 옵션(Product·Agent) 추가에 쓰는 토큰입니다. root 만 읽을 수 있게 저장합니다.")
        email = input("Jira 관리자 권한을 준 봇 계정 이메일: ").strip()
        token = getpass.getpass("그 계정의 API 토큰 (보이지 않음): ").strip()
    base = {"JIRA_URL": site, "JIRA_CLOUD_ID": cloud, "JIRA_EMAIL": email, "JIRA_TOKEN": token}
    # 일반 토큰은 사이트 주소, 범위 지정 토큰은 api.atlassian.com — 옵션 읽기까지 되는 쪽을 쓴다
    errors, chosen = {}, None
    for mode, label in (("false", "사이트 주소(일반 토큰)"), ("true", "api.atlassian.com(범위 지정 토큰)")):
        env = dict(base, JIRA_TOKEN_SCOPED=mode)
        try:
            ja = JiraAdmin(env)
            me = ja.req("GET", "/rest/api/3/myself")
            found = {alias: ja.options(alias)[2] for alias in ("product", "agent")}
            chosen = (env, me, found, label)
            break
        except Refuse as err:
            errors[label] = str(err)[:220]
    if not chosen:
        detail = "\n".join(f"  - {k}: {v}" for k, v in errors.items())
        raise Refuse("드롭다운 옵션을 읽지 못했습니다.\n" + detail +
                     "\n사이트 주소가 401 이면 범위 지정 토큰입니다 → 범위 없는 일반 'API 토큰 만들기' 토큰을 쓰세요."
                     "\n403 이면 계정에 Jira 관리자 권한이 없습니다.")
    env, me, found, label = chosen
    approver = (tc.get("admin") or {}).get("approver_account_id")
    if approver and me.get("accountId") == approver:
        raise Refuse("관리 요청 승인자(사람) 계정의 토큰입니다. 봇 전용 계정의 토큰을 넣어 주세요 (저장하지 않음).")
    for alias, opts in found.items():
        print(f"  ✅ {alias} 옵션 읽기: {', '.join(o['value'] for o in opts if not o.get('disabled'))}")
    write_secret(JIRA_ADMIN, env)
    print(f"🔑 저장: {JIRA_ADMIN} (root 전용) — 계정 {me.get('displayName', '')}, 접속 방식 {label}")
    return 0


def cmd_jira_option(a):
    value = a.value.strip()
    if not re.match(r"^[A-Za-z0-9._-]{1,30}$", value):
        raise Refuse("옵션 값은 영문·숫자·._- 1~30자")
    added = JiraAdmin().add_option(a.field, value)
    print(f"{'✅ 추가' if added else '이미 있음'}: {a.field} = {value}")
    return 0


def cmd_google_auth(a):
    google_auth(a.scopes.split(), a.out, a.owner, forbid=a.forbid.split() if a.forbid else (),
                require=a.scopes.split())
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="ai-approve")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("serve")
    sub.add_parser("status")
    sub.add_parser("setup-google")
    s = sub.add_parser("setup-jira-admin")
    s.add_argument("--from-bot", help="이 봇의 Jira 토큰을 그대로 사용 (예: leader)")
    s = sub.add_parser("jira-option")
    s.add_argument("field", choices=["agent", "product"])
    s.add_argument("value")
    s = sub.add_parser("google-auth")
    s.add_argument("--scopes", required=True)
    s.add_argument("--out", required=True)
    s.add_argument("--owner", required=True)
    s.add_argument("--forbid", default="")
    a = p.parse_args(argv)
    if a.cmd != "serve" and os.geteuid() != 0:
        sys.exit("root 권한이 필요합니다: sudo ai-approve …")
    try:
        return {"serve": cmd_serve, "status": cmd_status, "setup-google": cmd_setup_google,
                "google-auth": cmd_google_auth,
                "setup-jira-admin": cmd_setup_jira_admin, "jira-option": cmd_jira_option}[a.cmd](a)
    except Refuse as err:
        print(f"❌ {err}")
        return 1
    except KeyboardInterrupt:
        print("\n중단")
        return 130


if __name__ == "__main__":
    sys.exit(main())
