def write_dropin(unit, content):
    """봇별 드롭인. 내용이 바뀌었을 때만 True."""
    d = os.path.join(UNIT_DIR, f"{unit}.d")
    path = os.path.join(d, "50-ai-bot.conf")
    if not content:
        if os.path.exists(path):
            os.unlink(path)
            return True
        return False
    os.makedirs(d, exist_ok=True)
    try:
        with open(path, encoding="utf-8") as fh:
            if fh.read() == content:
                return False
    except FileNotFoundError:
        pass
    write_file(path, content, 0o644)
    return True


