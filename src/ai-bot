def last_vault_line(bot):
    log = os.path.join(bot.home, ".local", "state", "vault-sync.log")
    try:
        with open(log, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
        return lines[-1][:60] if lines else "기록 없음"
    except FileNotFoundError:
        return "기록 없음"


def cmd_status(args):
    bots = all_bots()
    if not bots:
        say("봇 정의가 없습니다. sudo ai-bot add <이름>")
        return 0
    table = process_table()
    claude_ver = out([CLAUDE, "--version"]) if os.path.exists(CLAUDE) else "미설치"
    say(f"공용 claude: {claude_ver}   감시 타이머: {out(['systemctl', 'is-active', 'ai-bot-watchdog.timer'])}")
    say(f"{'봇':12} {'사용자':16} {'서비스':10} {'플러그인':10} {'토큰':22} {'메모리':8} 기타")
    for bot in bots:
        if not bot.cfg["enabled"]:
            say(f"{bot.name:12} {bot.user:16} {'(disabled)':10}")
            continue
        if bot.pw() is None:
            say(f"{bot.name:12} {bot.user:16} {'사용자 없음 → sudo ai-bot apply ' + bot.name}")
            continue
        svc = out(["systemctl", "is-active", bot.unit]) if bot.cfg["telegram"] else "-"
        plugin = check_bot(bot, table)[0] if bot.cfg["telegram"] else "-"
        secrets = " ".join(f"{s}{'✓' if bot.has_secret(s) else '✗'}" for s in bot.needed_secrets())
        mem = out(["systemctl", "show", bot.unit, "-p", "MemoryCurrent", "--value"]) if bot.cfg["telegram"] else ""
        mem = f"{int(mem) // 2**20}M" if mem.isdigit() else "-"
        extra = []
        if bot.cfg["docker"]:
            sock = f"/run/user/{bot.pw().pw_uid}/docker.sock"
            extra.append("docker✓" if os.path.exists(sock) else "docker✗")
        if bot.vault:
            extra.append(f"볼트: {last_vault_line(bot)}")
        say(f"{bot.name:12} {bot.user:16} {svc:10} {plugin:10} {secrets:22} {mem:8} {' '.join(extra)}")
    return 0


