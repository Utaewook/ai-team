class Refuse(Exception):
    pass


def now():
    return dt.datetime.now(dt.timezone.utc)


def read_env(path):
    env = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    env[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return env


def write_secret(path, env, uid=0, gid=0):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("".join(f"{k}={v}\n" for k, v in env.items()))
    os.chown(tmp, uid, gid)
    os.replace(tmp, path)


def http(method, url, data=None, headers=None, form=False):
    body = None
    headers = dict(headers or {})
    if data is not None:
        if form:
            body = urllib.parse.urlencode(data).encode()
            headers["Content-Type"] = "application/x-www-form-urlencoded"
        else:
            body = json.dumps(data).encode()
            headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=body, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as err:
        raise Refuse(f"{method} {url.split('?')[0]} → HTTP {err.code}: {err.read().decode(errors='replace')[:300]}") from None


# ───────────────────────────── Google OAuth ─────────────────────────────

def access_token(env):
    out = http("POST", "https://oauth2.googleapis.com/token", {
        "client_id": env["GOOGLE_CLIENT_ID"], "client_secret": env["GOOGLE_CLIENT_SECRET"],
        "refresh_token": env["GOOGLE_REFRESH_TOKEN"], "grant_type": "refresh_token"}, form=True)
    return out["access_token"]


def token_scopes(token):
    info = http("GET", "https://oauth2.googleapis.com/tokeninfo?access_token=" + urllib.parse.quote(token))
    return set((info.get("scope") or "").split())


def client_credentials():
    env = read_env(CLIENT_FILE)
    if env.get("GOOGLE_CLIENT_ID") and env.get("GOOGLE_CLIENT_SECRET"):
        return env
    print("Google Cloud 의 OAuth 클라이언트(데스크톱 앱) 정보를 한 번만 입력합니다.")
    cid = input("클라이언트 ID: ").strip()
    secret = getpass.getpass("클라이언트 보안 비밀번호 (보이지 않음): ").strip()
    if not cid.endswith(".apps.googleusercontent.com") or not secret:
        raise Refuse("클라이언트 ID 형식이 아닙니다 (….apps.googleusercontent.com)")
    env = {"GOOGLE_CLIENT_ID": cid, "GOOGLE_CLIENT_SECRET": secret}
    write_secret(CLIENT_FILE, env)
    return env


def google_auth(scopes, out_path, owner, forbid=(), require=()):
    """사람이 PC 브라우저에서 동의 → 리디렉트 주소를 붙여넣기 → 토큰 저장. 토큰은 화면에 나오지 않는다."""
    client = client_credentials()
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode({
        "client_id": client["GOOGLE_CLIENT_ID"], "redirect_uri": REDIRECT, "response_type": "code",
        "scope": " ".join(scopes), "access_type": "offline", "prompt": "consent",
        "code_challenge": challenge, "code_challenge_method": "S256", "state": state})
    print("\n1) 아래 주소를 PC 브라우저에서 열고, 사용할 Google 계정으로 동의하세요.")
    print("   ('확인되지 않은 앱' 화면이 나오면 [고급] → [이동] 을 누르세요. 내가 만든 앱입니다.)\n")
    print(url)
    print("\n2) 동의 후 '사이트에 연결할 수 없음' 페이지가 뜨면 정상입니다. 그 페이지의 주소창 전체를 복사해 붙여넣으세요.")
    pasted = getpass.getpass("주소 (보이지 않음): ").strip()
    q = urllib.parse.parse_qs(urllib.parse.urlparse(pasted).query)
    if q.get("state", [""])[0] != state:
        raise Refuse("주소가 이번 요청의 것이 아닙니다 (state 불일치). 처음부터 다시 해 주세요.")
    if "error" in q:
        raise Refuse(f"동의가 취소되었습니다: {q['error'][0]}")
    code = q.get("code", [""])[0]
    tok = http("POST", "https://oauth2.googleapis.com/token", {
        "client_id": client["GOOGLE_CLIENT_ID"], "client_secret": client["GOOGLE_CLIENT_SECRET"],
        "code": code, "code_verifier": verifier, "grant_type": "authorization_code", "redirect_uri": REDIRECT}, form=True)
    if not tok.get("refresh_token"):
        raise Refuse("refresh 토큰을 받지 못했습니다. Google 계정 → 보안 → 타사 앱 액세스에서 이 앱을 지운 뒤 다시 해 주세요.")
    granted = set(tok.get("scope", "").split())
    bad = granted & set(forbid)
    if bad:
        raise Refuse(f"허용하면 안 되는 권한이 포함됐습니다: {', '.join(sorted(bad))} (저장하지 않음)")
    missing = set(require) - granted
    if missing:
        raise Refuse(f"필요한 권한이 빠졌습니다: {', '.join(sorted(missing))}. 동의 화면에서 모든 항목에 체크해 주세요 (저장하지 않음)")
    pw = pwd.getpwnam(owner)
    write_secret(out_path, {**client, "GOOGLE_REFRESH_TOKEN": tok["refresh_token"]}, pw.pw_uid, pw.pw_gid)
    print(f"✅ 저장: {out_path}  (권한: {', '.join(sorted(s.rsplit('/', 1)[-1] for s in granted))})")
    return granted


# ───────────────────────────── 행동: mail.send ─────────────────────────────

def check_addrs(value, field, required):
    items = [a.strip() for a in re.split(r"[,;]", value or "") if a.strip()]
    if required and not items:
        raise Refuse(f"{field} 가 비어 있습니다")
    if len(items) > 10:
        raise Refuse(f"{field} 는 10명까지")
    for a in items:
        addr = email.utils.parseaddr(a)[1]
        if not EMAIL_RE.match(addr):
            raise Refuse(f"{field} 주소 형식이 아닙니다: {a}")
    return items


def validate_mail(p):
    out = {"to": check_addrs(p.get("to"), "to", True), "cc": check_addrs(p.get("cc"), "cc", False),
           "subject": str(p.get("subject") or "").strip(), "body": str(p.get("body") or "")}
    if not out["subject"] or len(out["subject"]) > 250 or "\n" in out["subject"]:
        raise Refuse("제목은 1~250자, 한 줄")
    if not out["body"].strip() or len(out["body"]) > 20000:
        raise Refuse("본문은 1~20000자")
    for k in ("thread_id", "in_reply_to"):
        v = str(p.get(k) or "").strip()
        if v and (len(v) > 300 or "\n" in v):
            raise Refuse(f"{k} 형식 오류")
        out[k] = v
    return out


def describe_mail(p):
    body = p["body"].strip()
    short = body if len(body) <= 1500 else body[:1500] + "\n…(이하 생략)"
    lines = [f"받는 사람: {', '.join(p['to'])}"]
    if p["cc"]:
        lines.append(f"참조: {', '.join(p['cc'])}")
    lines.append(f"제목: {p['subject']}" + ("  (답장)" if p.get("thread_id") else ""))
    return "\n".join(lines) + f"\n\n{short}"


def execute_mail(p):
    env = read_env(BROKER_GOOGLE)
    if not env.get("GOOGLE_REFRESH_TOKEN"):
        raise Refuse("발송용 Gmail 토큰이 없습니다 (관리자: sudo ai-approve setup-google)")
    msg = email.message.EmailMessage()
    msg["To"] = ", ".join(p["to"])
    if p["cc"]:
        msg["Cc"] = ", ".join(p["cc"])
    msg["Subject"] = p["subject"]
    if p.get("in_reply_to"):
        msg["In-Reply-To"] = p["in_reply_to"]
        msg["References"] = p["in_reply_to"]
    msg.set_content(p["body"], charset="utf-8", cte="base64")
    raw = base64.urlsafe_b64encode(msg.as_bytes()).decode()
    body = {"raw": raw}
    if p.get("thread_id"):
        body["threadId"] = p["thread_id"]
    out = http("POST", "https://gmail.googleapis.com/gmail/v1/users/me/messages/send", body,
               {"Authorization": f"Bearer {access_token(env)}"})
    return f"발송 완료 (message id {out.get('id')})"


