class BotError(Exception):
    pass


def say(msg=""):
    print(msg, flush=True)


def run(cmd, check=True, capture=False, input_text=None, env=None, quiet=False, cwd=None):
    """명령 실행. check=True 면 실패 시 BotError."""
    res = subprocess.run(cmd, text=True, input=input_text, env=env, cwd=cwd,
                         stdout=subprocess.PIPE if capture or quiet else None,
                         stderr=subprocess.PIPE if capture or quiet else None)
    if check and res.returncode != 0:
        detail = ((res.stderr or "") + (res.stdout or "")).strip()[-800:] if (capture or quiet) else ""
        raise BotError(f"명령 실패 ({res.returncode}): {' '.join(cmd[:6])} …\n{detail}")
    return res


def out(cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()


def require_root():
    if os.geteuid() != 0:
        sys.exit("root 권한이 필요합니다: sudo ai-bot ...")


def write_file(path, content, mode, uid=0, gid=0):
    """임시 파일에 쓰고 권한을 맞춘 뒤 교체 (중간에 다른 권한으로 노출되지 않게)."""
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".ai-bot-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(content)
        os.chown(tmp, uid, gid)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def ensure_dir(path, mode, uid=0, gid=0):
    os.makedirs(path, exist_ok=True)
    st = os.lstat(path)
    if os.path.islink(path):
        raise BotError(f"{path} 가 심볼릭 링크입니다 — 확인이 필요합니다")
    if (st.st_uid, st.st_gid) != (uid, gid):
        os.chown(path, uid, gid)
    if (st.st_mode & 0o7777) != mode:
        os.chmod(path, mode)


def read_env_file(path):
    env = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    env[k.strip()] = v.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    return env


def load_json(path, default):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def team_config():
    try:
        with open(TEAM_CONFIG, encoding="utf-8") as fh:
            return yaml.safe_load(fh) or {}
    except FileNotFoundError:
        return {}


