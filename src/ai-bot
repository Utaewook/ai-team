def apply_bot(bot, start=True):
    say(f"▶ {bot.name} ({bot.user})")
    if not bot.cfg["enabled"]:
        say("  ⏸ 정의에서 enabled: false — 건너뜀 (중지는 sudo ai-bot disable)")
        return True
    pw = ensure_user(bot)
    if bot.cfg["jira"]:
        write_jira_shared()
    ensure_agent_option(bot)
    install_role_files(bot, pw)
    ensure_user_dirs(bot, pw)
    seed_claude_state(bot, pw)
    ensure_git(bot)
    reload_needed = write_dropin(bot.unit, bot_dropin(bot, pw))
    reload_needed |= ensure_approve_group(bot)
    if bot.cfg.get("browser"):
        reload_needed |= ensure_browser(bot, pw)
        if reload_needed:
            systemctl("daemon-reload")
        start_browser(bot)
    if bot.cfg["docker"]:
        ensure_docker(bot, pw)
    if ensure_vault(bot):
        reload_needed = True
    missing = [s for s in bot.needed_secrets() if not bot.has_secret(s)]
    if reload_needed:
        systemctl("daemon-reload")
    if bot.vault and bot.has_secret("github"):
        systemctl("enable", "--now", f"ai-vault-sync@{bot.name}.timer")
    if bot.cfg["telegram"] and bot.has_secret("claude"):
        ensure_plugin(bot)
    if missing:
        say(f"  ⚠️ 토큰 필요: " + ", ".join(f"sudo ai-bot secret {bot.name} {s}" for s in missing))
        essential = [s for s in missing if s in ("claude", "telegram")]
        if not essential:
            say("     (봇 실행에 꼭 필요한 토큰은 있어 서비스는 그대로 둡니다)")
        elif bot.cfg["telegram"]:
            systemctl("disable", "--now", bot.unit, check=False)
            return False
        else:
            return False
    if bot.cfg["telegram"]:
        if start:
            active = out(["systemctl", "is-active", bot.unit]) == "active"
            systemctl("enable", bot.unit)
            systemctl("restart" if (active and reload_needed) else "start", bot.unit)
            say(f"  ✅ 서비스 {'재시작' if active and reload_needed else '실행 중'}: {bot.unit}")
        else:
            say("  ✅ 준비 완료 (시작은 하지 않음)")
    else:
        say("  ✅ 준비 완료 (Telegram 없음 — 디스패처 작업 전용)")
    return True


def cmd_apply(args):
    names = args.names or [b.name for b in all_bots()]
    if not names:
        say("봇 정의가 없습니다. sudo ai-bot add <이름>")
        return 1
    ok = True
    for name in names:
        try:
            ok &= apply_bot(Bot(name), start=not args.no_start)
        except BotError as err:
            say(f"  ❌ {err}")
            ok = False
    return 0 if ok else 1


