# /etc/ai-team/jira.env  (root 600) — 봇 전용 Jira 계정의 범위 지정 API 토큰
# 필요한 범위: read:jira-work, write:jira-work, read:jira-user
# 줄 끝에 주석을 달지 마세요 (값의 일부로 읽힙니다).
# JIRA_CLOUD_ID 는 비워 두면 jira-setup.py 가 찾아서 알려 줍니다.
JIRA_URL=https://<사이트>.atlassian.net
JIRA_CLOUD_ID=
JIRA_EMAIL=<봇 계정 이메일>
JIRA_TOKEN=<토큰>
JIRA_TOKEN_SCOPED=true
