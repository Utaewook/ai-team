def cmd_check(args):
    """봇 토큰으로 Claude 가 실제로 응답하는지 확인 (아주 짧은 요청 1회, haiku)."""
    bot = Bot(args.name)
    if not bot.has_secret("claude"):
        raise BotError(f"Claude 토큰이 없습니다: sudo ai-bot secret {bot.name} claude")
    token = read_env_file(bot.claude_env)["CLAUDE_CODE_OAUTH_TOKEN"]
    # Telegram 플러그인을 끈 채 실행 (켜면 대화형 봇의 Telegram 연결을 끊음)
    res = as_user(bot, [CLAUDE, "-p", "OK 라고만 답하세요", "--max-turns", "1", "--model", "haiku",
                        "--output-format", "json", "--settings", json.dumps({"enabledPlugins": {PLUGIN: False}})],
                  env_extra={"CLAUDE_CODE_OAUTH_TOKEN": token, "TELEGRAM_STATE_DIR": "/nonexistent/ai-team-headless"},
                  check=False, cwd=bot.cwd)
    try:
        data = json.loads(res.stdout)
        good = not data.get("is_error") and "OK" in (data.get("result") or "")
    except json.JSONDecodeError:
        data, good = {}, False
    if good:
        say(f"✅ {bot.name}: Claude 응답 확인 (사용량 ${data.get('total_cost_usd', 0):.4f})")
        return 0
    say(f"❌ {bot.name}: Claude 응답 실패\n{(data.get('result') or res.stdout or res.stderr)[-500:]}")
    return 1


def cdp_open(bot, url):
    """상시 브라우저에 새 탭 (봇 사용자로 — CDP 포트는 그 사용자만 접속 가능)."""
    code = ("import sys,urllib.request,urllib.parse;"
            "urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:%s/json/new?'+sys.argv[1],method='PUT'),timeout=10)"
            % cdp_port(bot))
    subprocess.run(["runuser", "-u", bot.user, "--", "python3", "-c", code, url], capture_output=True, cwd=bot.home)


def cmd_browser_login(args):
    """사람이 VNC 로 봇의 상시 브라우저에 직접 로그인 (비밀번호는 봇이 모름). 봇은 멈추지 않는다."""
    import secrets as _secrets
    import signal
    bot = Bot(args.name)
    if not bot.cfg.get("browser"):
        raise BotError(f"{bot.name} 는 browser 설정이 없습니다")
    d = bot.cfg["browser"]["display"]
    vnc_port, web_port = 5900 + d, args.port
    env = ["env", f"HOME={bot.home}", f"DISPLAY=:{d}", f"XAUTHORITY={bot.home}/.Xauthority"]
    start_browser(bot)
    time.sleep(3)
    for url in (args.urls or [f"https://{h}" for h in bot.cfg["browser"]["allow"][:3]]):
        cdp_open(bot, url)
    vnc_pw = _secrets.token_urlsafe(6)[:8]
    pwfile = os.path.join(bot.home, ".vnc-login-pass")
    run(["runuser", "-u", bot.user, "--", "x11vnc", "-storepasswd", vnc_pw, pwfile], quiet=True, cwd=bot.home)
    procs = []
    try:
        procs.append(subprocess.Popen(["runuser", "-u", bot.user, "--"] + env + [
            "x11vnc", "-display", f":{d}", "-localhost", "-rfbport", str(vnc_port), "-rfbauth", pwfile,
            "-forever", "-shared", "-quiet", "-noxdamage", "-xkb", "-skip_lockkeys"],
            cwd=bot.home, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        procs.append(subprocess.Popen(["runuser", "-u", bot.user, "--", "websockify", "--web", "/usr/share/novnc",
                                       f"127.0.0.1:{web_port}", f"127.0.0.1:{vnc_port}"],
                                      cwd=bot.home, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        time.sleep(2)
        say(f"""
🖥  {bot.name} 의 브라우저 화면을 열었습니다. (봇은 계속 동작 중 — 로그인하는 동안 작업을 시키지 마세요)
  1) PC 에서 새 터미널을 열고, 평소 VM 접속 명령의 'ssh' 바로 뒤에 -L {web_port}:127.0.0.1:{web_port} 를 붙여 접속
       예) ssh -L {web_port}:127.0.0.1:{web_port} -i ~/.ssh/<키파일> ubuntu@<VM IP>      (이 창은 열어 둔 채로)
  2) PC 브라우저 주소창: http://localhost:{web_port}/vnc.html → [연결] → 비밀번호: {vnc_pw}
  3) 열린 탭에서 각 사이트에 직접 로그인 (2차 인증 포함). '로그인 상태 유지'가 있으면 체크.
  4) 다 되면 이 창에서 Enter → 화면 공유만 닫습니다(브라우저·로그인은 그대로). 30분 지나면 자동으로 닫힙니다.
""")
        signal.signal(signal.SIGALRM, lambda *_: (_ for _ in ()).throw(TimeoutError()))
        signal.alarm(1800)
        try:
            input()
        except (TimeoutError, EOFError):
            say("⏱ 시간 초과 — 화면 공유를 닫습니다")
        signal.alarm(0)
    finally:
        for p in procs:
            p.terminate()
        try:
            os.unlink(pwfile)
        except FileNotFoundError:
            pass
        say("✅ 화면 공유 종료. 로그인 세션은 상시 브라우저에 남아 있습니다.")
    return 0


def cmd_disable(args):
    bot = Bot(args.name)
    systemctl("disable", "--now", bot.unit, check=False)
    systemctl("disable", "--now", f"ai-vault-sync@{bot.name}.timer", check=False)
    for unit in (f"ai-browser-keepalive@{bot.name}.timer", f"ai-chrome@{bot.name}.service", f"ai-xvfb@{bot.name}.service"):
        systemctl("disable", "--now", unit, check=False)
    if bot.pw():
        run(["usermod", "--lock", "--expiredate", "1", bot.user], quiet=True)
        run(["loginctl", "disable-linger", bot.user], check=False, quiet=True)
    path = os.path.join(bot.defdir, "bot.yaml")
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    text = re.sub(r"(?m)^enabled:\s*\S+", "enabled: false", text) if re.search(r"(?m)^enabled:", text) \
        else "enabled: false\n" + text
    write_file(path, text, 0o600)
    say(f"⏸ {bot.name} 중지·계정 잠금. 홈 폴더({bot.home})와 정의는 보관했습니다.")
    say(f"   다시 쓰려면: bot.yaml 의 enabled 를 true 로 바꾸고 sudo usermod --unlock --expiredate '' {bot.user} 후 sudo ai-bot apply {bot.name}")
    return 0


def cmd_init(args):
    os.makedirs(BOTS_DIR, mode=0o700, exist_ok=True)
    os.chmod(BOTS_DIR, 0o700)
    for name, content in UNITS.items():
        write_file(os.path.join(UNIT_DIR, name), content, 0o644)
    say("🧱 systemd 유닛 설치: " + ", ".join(UNITS))
    if args.skip_binaries:
        say("   (공용 실행 파일 설치는 건너뜀)")
    else:
        if not os.path.exists(CLAUDE) or args.force:
            say(f"⬇️ 공용 claude 설치: {install_claude()}")
        if not os.path.exists(os.path.join(BIN, "bun")) or args.force:
            say(f"⬇️ 공용 bun 설치: {install_bun()}")
    systemctl("daemon-reload")
    systemctl("enable", "--now", "ai-bot-watchdog.timer")
    if subprocess.run(["getent", "group", APPROVE_GROUP], capture_output=True).returncode != 0:
        run(["groupadd", "--system", APPROVE_GROUP], quiet=True)
    systemctl("enable", "--now", "ai-approve.socket")
    say("🔐 확인 서비스 소켓 시작 (/run/ai-approve.sock)")
    say("👀 감시 타이머 시작 (2분마다)")
    return 0


def cmd_update(args):
    old = out([CLAUDE, "--version"]) if os.path.exists(CLAUDE) else "없음"
    install_claude()
    new = out([CLAUDE, "--version"])
    say(f"claude: {old} → {new}")
    say(f"bun: {install_bun()}")
    if args.no_restart:
        return 0
    for bot in all_bots(include_disabled=False):
        if not bot.cfg["telegram"] or out(["systemctl", "is-active", bot.unit]) != "active":
            continue
        systemctl("restart", bot.unit, check=False)
        for _ in range(24):
            time.sleep(5)
            if check_bot(bot, process_table())[0] == "ok":
                break
        say(f"  {bot.name}: {check_bot(bot, process_table())[1]}")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="ai-bot", description="AI 팀 봇 관리 (root 전용)")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("init")
    s.add_argument("--skip-binaries", action="store_true")
    s.add_argument("--force", action="store_true", help="공용 claude/bun 다시 설치")
    s = sub.add_parser("add")
    s.add_argument("name")
    s.add_argument("--like", help="이 봇의 정의를 복사해서 시작")
    s.add_argument("--description")
    s.add_argument("--yes", action="store_true", help="정의 편집 대기 없이 진행")
    s.add_argument("--no-secrets", action="store_true")
    s = sub.add_parser("apply")
    s.add_argument("names", nargs="*")
    s.add_argument("--no-start", action="store_true", help="서비스는 시작하지 않음")
    s = sub.add_parser("secret")
    s.add_argument("name")
    s.add_argument("kind", choices=["claude", "telegram", "github", "jira", "google"])
    s.add_argument("--no-apply", action="store_true")
    sub.add_parser("status")
    s = sub.add_parser("logs")
    s.add_argument("name")
    s.add_argument("-n", type=int, default=40)
    for c in ("attach", "shell", "disable", "check"):
        sub.add_parser(c).add_argument("name")
    for c in ("start", "stop", "restart"):
        sub.add_parser(c).add_argument("name")
    s = sub.add_parser("cdp-guard")
    s.add_argument("name")
    s = sub.add_parser("browser-login")
    s.add_argument("name")
    s.add_argument("urls", nargs="*")
    s.add_argument("--port", type=int, default=6080)
    s = sub.add_parser("update")
    s.add_argument("--no-restart", action="store_true")
    s = sub.add_parser("watchdog")
    s.add_argument("--status", action="store_true")
    s = sub.add_parser("agents", help="디스패처가 보는 봇 목록 (확인용)")
    args = p.parse_args(argv)

    require_root()
    handlers = {"init": cmd_init, "add": cmd_add, "apply": cmd_apply, "secret": cmd_secret,
                "status": cmd_status, "logs": cmd_logs, "attach": cmd_attach, "shell": cmd_shell,
                "start": cmd_service, "stop": cmd_service, "restart": cmd_service, "disable": cmd_disable,
                "update": cmd_update, "watchdog": cmd_watchdog, "check": cmd_check, "browser-login": cmd_browser_login, "cdp-guard": cmd_cdp_guard,
                "agents": lambda a: say(json.dumps(dispatcher_agents(), ensure_ascii=False, indent=2)) or 0}
    try:
        return handlers[args.cmd](args) or 0
    except BotError as err:
        say(f"❌ {err}")
        return 1
    except KeyboardInterrupt:
        say("\n중단")
        return 130


if __name__ == "__main__":
    sys.exit(main())
