        run(["gpasswd", "-d", bot.user, APPROVE_GROUP], quiet=True)
        say("  🔐 확인 서비스 사용 해제")
        return True
    return False


def chrome_path():
    """Playwright MCP 가 기대하는 Chromium 리비전을 우선, 없으면 설치된 것 중 최신."""
    import glob
    try:
        bj = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(PW_MCP))), "playwright-core", "browsers.json")
        rev = next(b["revision"] for b in json.load(open(bj))["browsers"] if b["name"] == "chromium")
        exact = glob.glob(os.path.join(PW_BROWSERS, f"chromium-{rev}", "chrome-linux*", "chrome"))
        if exact:
            return exact[0]
    except (OSError, StopIteration, KeyError, json.JSONDecodeError):
        pass
    found = sorted(glob.glob(os.path.join(PW_BROWSERS, "chromium-*", "chrome-linux*", "chrome")),
                   key=lambda x: int(re.search(r"chromium-(\d+)", x).group(1)))
    if not found:
        raise BotError(f"Chromium 이 없습니다 ({PW_BROWSERS}). 브라우저 설치 스크립트를 먼저 실행하세요")
    return found[-1]


def cdp_port(bot):
    return 9200 + bot.cfg["browser"]["display"]


def ensure_browser(bot, pw):
    """상시 브라우저(ai-chrome@) + Playwright MCP 는 CDP 로 붙기 + 세션 유지 타이머. 바뀌면 True."""
    b = bot.cfg["browser"]
    changed = False
    for name, content in BROWSER_UNITS.items():   # 예전에 init 한 서버에도 유닛이 생기도록
        path = os.path.join(UNIT_DIR, name)
        try:
            same_unit = open(path, encoding="utf-8").read() == content
        except FileNotFoundError:
            same_unit = False
        if not same_unit:
            write_file(path, content, 0o644)
            changed = True
    ensure_dir(bot.profile, 0o700, pw.pw_uid, pw.pw_gid)
    out_dir = os.path.join(bot.cwd, "notes", "browser") if "notes" in bot.cfg["writable"] else bot.profile + "-out"
    if not os.path.isdir(out_dir):
        ensure_dir(out_dir, 0o700, pw.pw_uid, pw.pw_gid)
    port = cdp_port(bot)
    keep = [u for u in (b.get("keepalive") or []) if re.match(r"^https://[A-Za-z0-9.-]+(/[^\s]*)?$", str(u))]
    relogin = [n for n in (b.get("relogin") or []) if re.match(r"^[a-z0-9_-]{1,30}$", str(n))]
    env_text = (f"AI_DISPLAY={b['display']}\nAI_CDP_PORT={port}\nAI_CHROME={chrome_path()}\n"
                f"AI_PROFILE={bot.profile}\nAI_KEEPALIVE={' '.join(keep)}\nAI_RELOGIN={' '.join(relogin)}\n")
    ensure_dir(os.path.join(ETC, "chrome"), 0o755, 0, 0)
    env_path = os.path.join(ETC, "chrome", f"{bot.name}.env")
    try:
        same_env = open(env_path, encoding="utf-8").read() == env_text
    except FileNotFoundError:
        same_env = False
    if not same_env:
        write_file(env_path, env_text, 0o644)
        changed = True
    conf = {"browser": {"browserName": "chromium", "cdpEndpoint": f"http://127.0.0.1:{port}", "cdpTimeout": 30000},
            "outputDir": out_dir}
    text = json.dumps(conf, ensure_ascii=False, indent=2) + "\n"
    try:
        same = open(bot.pw_config, encoding="utf-8").read() == text
    except FileNotFoundError:
        same = False
    if not same:
        write_file(bot.pw_config, text, 0o640, 0, pw.pw_gid)
    # 브라우저가 정상 종료 후 다시 켜질 때 탭을 복원 (로그인 유지는 상시 실행이 담당)
    prefs_path = os.path.join(bot.profile, "Default", "Preferences")
    if not os.path.isfile(prefs_path):
        ensure_dir(os.path.dirname(prefs_path), 0o700, pw.pw_uid, pw.pw_gid)
        write_file(prefs_path, json.dumps({"session": {"restore_on_startup": 1}}), 0o600, pw.pw_uid, pw.pw_gid)
    changed |= write_dropin(f"ai-xvfb@{bot.name}.service", f"[Service]\nEnvironment=AI_DISPLAY={b['display']}\n")
    minutes = int(b.get("keepalive_minutes") or 40)
    changed |= write_dropin(f"ai-browser-keepalive@{bot.name}.timer",
                            # 빈 값은 타이머 목록 전체를 지우므로 시작 시점들도 다시 적는다
                            f"[Timer]\nOnUnitActiveSec=\nOnActiveSec=2min\nOnBootSec=10min\n"
                            f"OnUnitActiveSec={max(15, minutes)}min\n")
    return changed or not same


def start_browser(bot):
    """상시 브라우저와 세션 유지 타이머 켜기 (apply 에서 호출)."""
    systemctl("enable", "--now", f"ai-xvfb@{bot.name}.service")
    if subprocess.run(["systemctl", "is-active", "--quiet", f"ai-chrome@{bot.name}.service"]).returncode != 0:
        # 예전 방식(봇 세션마다 Playwright 가 띄운 브라우저)이 프로필을 잡고 있으면 상시 브라우저가 못 뜸
        subprocess.run(["pkill", "-TERM", "-u", bot.user, "-f", "browser-profile"], capture_output=True)
        time.sleep(2)
    systemctl("enable", "--now", f"ai-chrome@{bot.name}.service")
    if bot.cfg["browser"].get("keepalive") or bot.cfg["browser"].get("relogin"):
        systemctl("enable", "--now", f"ai-browser-keepalive@{bot.name}.timer")
    else:
        systemctl("disable", "--now", f"ai-browser-keepalive@{bot.name}.timer", check=False)


def cmd_cdp_guard(args):
    """상시 브라우저의 CDP 포트를 그 봇 사용자만 쓰게 (ai-chrome@ 시작 전 root 로 실행, 여러 번 실행해도 안전)."""
    bot = Bot(args.name)
    pw = bot.pw()
    if pw is None or not bot.cfg.get("browser"):
        raise BotError(f"{bot.name}: 봇 사용자 또는 browser 설정이 없습니다")
    rule = ["OUTPUT", "-o", "lo", "-p", "tcp", "--dport", str(cdp_port(bot)),
            "-m", "owner", "!", "--uid-owner", str(pw.pw_uid), "-j", "REJECT"]
    if subprocess.run(["iptables", "-C", *rule], capture_output=True).returncode != 0:
        run(["iptables", "-I", *rule], quiet=True)
    return 0


def bot_dropin(bot, pw):
    lines = ["[Service]"]
    if bot.cfg["docker"]:
        lines += [f"Environment=XDG_RUNTIME_DIR=/run/user/{pw.pw_uid}",
                  f"Environment=DOCKER_HOST=unix:///run/user/{pw.pw_uid}/docker.sock"]
    if bot.cfg.get("browser"):
        d = bot.cfg["browser"]["display"]
        lines = ["[Unit]", f"Requires=ai-xvfb@{bot.name}.service ai-chrome@{bot.name}.service",
                 f"After=ai-xvfb@{bot.name}.service ai-chrome@{bot.name}.service"] + lines
        lines += [f"Environment=DISPLAY=:{d}", f"Environment=XAUTHORITY={bot.home}/.Xauthority"]
    if bot.cfg.get("memory_max"):
        lines.append(f"MemoryMax={bot.cfg['memory_max']}")
    if bot.cfg.get("interactive_model"):   # Telegram 대화용 모델을 따로 고정하고 싶을 때만
        lines.append(f"Environment=ANTHROPIC_MODEL={bot.cfg['interactive_model']}")
    return "\n".join(lines) + "\n" if len(lines) > 1 else ""


def write_jira_shared():
    """ai-jira 가 읽는 비밀 아닌 설정 (/etc/ai-team-jira.yaml, 644). team-config 의 jira 부분 + 봇·프로젝트 목록."""
    tc = team_config()
    j = tc.get("jira") or {}
    if not j.get("fields"):
        return False
    shared = {"timezone": tc.get("timezone", "Asia/Seoul"),
              "jira": {"site": j.get("site", ""), "project_key": j.get("project_key", "TEAM"),
                       "task_type_id": str(j.get("task_type_id", "")), "fields": j["fields"],
                       "statuses": {k: str(v) for k, v in (j.get("statuses") or {}).items()},
