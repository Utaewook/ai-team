class Bot:
    """bots.d/<이름>/bot.yaml + 규칙으로 정해지는 경로들."""

    def __init__(self, name):
        if not NAME_RE.match(name or ""):
            raise BotError(f"봇 이름은 영문 소문자로 시작하는 2~21자(소문자·숫자·-)여야 합니다: {name!r}")
        self.name = name
        self.defdir = os.path.join(BOTS_DIR, name)
        self.user = f"bot-{name}"
        self.home = os.path.join(HOME_BASE, self.user)
        self.cwd = os.path.join(self.home, "bots", name)
        self.secrets = os.path.join(self.home, ".config", "ai-bot")
        self.claude_env = os.path.join(self.secrets, "claude.env")
        self.tg_dir = os.path.join(self.home, ".claude", "channels", f"telegram-{name}")
        self.tg_env = os.path.join(self.tg_dir, ".env")
        self.access = os.path.join(self.tg_dir, "access.json")
        self.git_cred = os.path.join(self.home, ".git-credentials")
        self.jira_env = os.path.join(self.secrets, "jira.env")
        self.google_env = os.path.join(self.secrets, "google.env")
        self.profile = os.path.join(self.home, ".browser-profile")
        self.pw_config = os.path.join(self.cwd, "playwright.json")
        self.gh_hosts = os.path.join(self.home, ".config", "gh", "hosts.yml")
        self.unit = f"ai-bot@{name}.service"
        self.cfg = self._load()

    def _load(self):
        path = os.path.join(self.defdir, "bot.yaml")
        if not os.path.isfile(path):
            raise BotError(f"봇 정의가 없습니다: {path}  (새로 만들려면 sudo ai-bot add {self.name})")
        with open(path, encoding="utf-8") as fh:
            cfg = yaml.safe_load(fh) or {}
        cfg.setdefault("enabled", True)
        cfg.setdefault("telegram", True)
        cfg.setdefault("docker", False)
        cfg.setdefault("github", False)
        cfg.setdefault("jira", False)
        cfg.setdefault("google", False)
        cfg.setdefault("approve", [])
        if cfg.get("browser") is True:
            cfg["browser"] = {}
        if cfg.get("browser"):
            b = cfg["browser"]
            b.setdefault("display", 50)
            b.setdefault("allow", [])
            if not isinstance(b["display"], int) or not 10 <= b["display"] <= 99:
                raise BotError(f"{self.name}: browser.display 는 10~99")
        cfg.setdefault("writable", [])
        for w in cfg["writable"]:
            if not re.match(r"^[A-Za-z0-9._-]+$", str(w)) or w in (".", "..", ".claude"):
                raise BotError(f"{self.name}: writable 항목이 올바르지 않습니다: {w!r}")
        return cfg

    def path_in_home(self, p):
        p = os.path.normpath(os.path.join(self.home, p))
        if not (p == self.home or p.startswith(self.home + os.sep)):
            raise BotError(f"{self.name}: 홈 폴더 밖 경로는 쓸 수 없습니다: {p}")
        return p

    @property
    def vault(self):
        v = self.cfg.get("vault")
        if not v:
            return None
        return {"repo": v["repo"], "dir": self.path_in_home(v.get("dir", "vault")),
                "interval": v.get("interval", "5min")}

    @property
    def repos(self):
        return {k: self.path_in_home(v) for k, v in (self.cfg.get("repos") or {}).items()}

    def pw(self):
        try:
            return pwd.getpwnam(self.user)
        except KeyError:
            return None

    def has_secret(self, kind):
        if kind == "claude":
            return bool(read_env_file(self.claude_env).get("CLAUDE_CODE_OAUTH_TOKEN"))
        if kind == "telegram":
            return bool(read_env_file(self.tg_env).get("TELEGRAM_BOT_TOKEN"))
        if kind == "github":
            return os.path.isfile(self.git_cred) and os.path.getsize(self.git_cred) > 0
        if kind == "jira":
            return bool(read_env_file(self.jira_env).get("JIRA_TOKEN"))
        if kind == "google":
            return bool(read_env_file(self.google_env).get("GOOGLE_REFRESH_TOKEN"))
        raise ValueError(kind)

    def needed_secrets(self):
        need = ["claude"]
        if self.cfg["telegram"]:
            need.append("telegram")
        if self.cfg["github"] or self.vault:
            need.append("github")
        if self.cfg["jira"]:
            need.append("jira")
        if self.cfg["google"]:
            need.append("google")
        return need


def all_bots(include_disabled=True):
    if not os.path.isdir(BOTS_DIR):
        return []
    bots = []
    for name in sorted(os.listdir(BOTS_DIR)):
        if name.startswith((".", "_")) or not os.path.isfile(os.path.join(BOTS_DIR, name, "bot.yaml")):
            continue
        bot = Bot(name)
        if include_disabled or bot.cfg["enabled"]:
            bots.append(bot)
    return bots


def dispatcher_agents(bots_dir=None):
    """디스패처가 쓰는 형태로 변환 (dispatcher.py 의 load_bot_agents 와 같은 규칙)."""
    agents = {}
    for bot in all_bots(include_disabled=False):
        d = bot.cfg.get("dispatch")
        if d is False:
            continue
        d = d or {}
        agents[bot.name] = {"user": bot.user, "cwd": bot.cwd, "claude_bin": CLAUDE,
                            "model": d.get("model", bot.cfg.get("model")),
                            "work_in_repo": bool(d.get("work_in_repo")),
                            "extra_args": list(d.get("extra_args") or []),
                            "repos": bot.repos, "env_file": bot.claude_env,
                            "display": bot.cfg["browser"]["display"] if bot.cfg.get("browser") else None}
    return agents


